{
  "name": "aivision",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "start": "expo start apps/mobile",
    "mobile": "expo start apps/mobile",
    "mobile:android": "expo start apps/mobile --android",
    "build:mobile": "npm --workspace @aivision/mobile run export:android",
    "build:apk": "npm --workspace @aivision/mobile run build:apk:eas",
    "build:production-apk": "npm --workspace @aivision/mobile run build:production-apk:eas",
    "lint": "npm --workspace @aivision/mobile run lint",
    "typecheck": "npm --workspace @aivision/mobile run typecheck",
    "test:mobile": "npm --workspace @aivision/mobile run test"
  },
  "engines": {
    "node": ">=22"
  }
}
