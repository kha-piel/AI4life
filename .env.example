# API
VISION_PROVIDER=groq
ALLOW_FIXTURE_FALLBACK=false
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_TIMEOUT_SECONDS=30
# Local development stays false. Public cloud deployment must set this true.
REQUIRE_APP_AUTH=false
# Comma-separated SHA-256 hashes; never put raw invitation codes here.
APP_ACCESS_TOKEN_HASHES=
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=INFO
LOCAL_UID=1000
LOCAL_GID=1000

# Expo reads only EXPO_PUBLIC_* values in the mobile bundle.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
